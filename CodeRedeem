local function updateDelay()

	local value = tonumber(delayBox.Text)

	if value then
		value = math.clamp(value, 0, 10)
		config.delayTime = value
		delayBox.Text = tostring(value)
	else
		config.delayTime = 0.2
		delayBox.Text = "0.2"
	end

end

local function updateWordTarget()

	local value = tonumber(wordBox.Text)

	if value then

		value = math.max(1, math.floor(value))

		config.wordSubmitTarget = value

		wordBox.Text = tostring(value)

	else

		config.wordSubmitTarget = 1
		wordBox.Text = "1"

	end

end

